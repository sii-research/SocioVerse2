  "assumptions": [
    {
      "id": "a-buyer-pool-fixed",
      "claim": "固定购车潜在人群池，每月一部分人做出购车决策(纵向面板)",
      "rationale": "SocioVerse2 核心 B=f(P,E)：同一批agent贯穿30个月，市占率=其逐月品牌选择的聚合"
    },
    {
      "id": "a-monthly-path",
      "claim": "月度轨迹在已知年度锚点间平滑演化，补贴退出/新车型等事件造成拐点",
      "rationale": "仅有年度KBA锚点，月度形状由环境事件与人群决策生成而非直接观测"
    },
    {
      "id": "a-userpool-weak-fit",
      "claim": "user_pool问卷MCP人群池(X/小红书)与德国购车者匹配度低，默认不接入",
      "rationale": "人群应为德国购车潜在者，社媒人群池地域/主题不匹配；如需真实问卷基线可显式开启(付费)"
    },
    {
      "id": "a-porsche-in-other",
      "claim": "保时捷不单列，并入Other(与上传KBA真值数据口径一致)",
      "rationale": "用户上传的KBA真值只单列12个品牌，保时捷在Other中；为保证每个追踪品牌都有真值锚定，采用数据口径"
    },
    {
      "id": "a-window-29",
      "claim": "研究窗对齐真值到2024-01→2026-05(29个月)",
      "rationale": "上传数据到2026-05，全程有KBA月度真值可对齐校验"
    },
    {
      "id": "a-discrete-choice",
      "claim": "品牌选择建模为随机效用多项logit：base_appeal(锚定2024-01真实份额取对数)+个体×品牌交互(忠诚/电动/豪华/德系/价格)+环境信号(EV气候/BYD铺货/特斯拉冲击)",
      "rationale": "离散选择是品牌选择的标准建模范式；t=0中性环境下softmax(base_appeal)复现2024-01基线份额"
    },
    {
      "id": "a-trait-derivation",
      "claim": "个体潜在偏好特质(价格敏感度/电动亲和/豪华偏好/德系偏好/品牌忠诚/新势力开放度)由真实人口属性确定性派生+抖动",
      "rationale": "上传数据提供真实人口属性但无偏好标签；用可解释映射(年轻/大城市/高教育→更电动更开放；高收入/中年→更豪华更忠诚)派生"
    },
    {
      "id": "a-ev-recovery",
      "claim": "EV需求气候2024补贴退出后低迷(~0.35)、2025-26随CO2车队目标与降价logistic回暖(~0.65)",
      "rationale": "呼应真实轨迹中2024 EV承压、2025+回暖；无逐月官方EV需求指数，用平滑曲线近似"
    },
    {
      "id": "a-price-drift",
      "claim": "各品牌价格指数月度通胀漂移≈+0.4%/月，叠加特斯拉2024降价、比亚迪2025竞争性定价事件",
      "rationale": "无逐品牌逐月成交价，用温和通胀+已知促销方向近似"
    },
    {
      "id": "a-n-agents-1500",
      "claim": "购车潜在人群池默认1500人(可调)",
      "rationale": "足够采样13品牌份额(最小BYD基线0.07%需较大n才稳定)且scripted跑批可控；真实LLM跑批时按预算调小"
    },
    {
      "id": "a-truth-anchor-smoothing",
      "claim": "v2:品牌基线吸引力每步锚在上月(真值×λ+模拟×(1-λ))份额, λ=0.7; 环境偏离项调小为agent层机制纹理",
      "rationale": "LLM独立抽样与固定基线均难复现13路长尾分布(Other~28%), 真值锚每月重注入长尾结构上杜绝模式坍塌; scripted扫参标定MAE≈0.75pp/格"
    },
    {
      "id": "a-real-signal-driven",
      "claim": "v3:环境信号ev_climate/byd_ramp/tesla_shock改为真实KBA月度份额序列派生(比亚迪份额归一化/特斯拉份额相对基线偏离/纯电份额归一化),不再是手写解析曲线",
      "rationale": "把外部环境信息真正接入动态E:信号形状由真实德国数据决定而非假设,WebSearch锚定的比亚迪销量+750%/特斯拉-48%/BEV回暖佐证走势"
    }
  ]
}